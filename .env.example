# ==========================================
# 9Router ACP Server Configuration (.env)
# ==========================================

# 1. 9Router AI Gateway Connection
ROUTER_HOST=your-router-host-or-ip.com
ROUTER_PORT=8080
ROUTER_API_KEY=your_9router_api_key_here
ROUTER_MODEL=ag/claude-sonnet-4-6

# 2. Autonomous Agent Safety Limits
# 0 = completely unlimited autonomous turns
MAX_TURNS=0

# 3. Custom Extra Skills Folder (Optional)
# Point to any custom directory containing skills on your computer:
# EXTRA_SKILLS_PATH=C:/path/to/my-custom-skills

# 4. Remote Hermes Server Integration (Optional)
# If you have Hermes running on a remote VPS/Server, set its HTTP/skills endpoint here:
# REMOTE_HERMES_URL=http://your-remote-server-ip:8000/skills
REMOTE_HERMES_URL=

# 5. Local Hermes Path Override (Optional)
# Default is ~/.hermes/hermes-agent/skills
# HERMES_SKILLS_PATH=
